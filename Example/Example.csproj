<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
    <RootNamespace>Example</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Countries Example</ApplicationTitle>
    <ApplicationId>com.challengeapp.countryexample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="ChallengeApp.Core" Version="1.0.0" />
    <PackageReference Include="ChallengeApp.DesignSystem" Version="1.0.0" />
    <PackageReference Include="ChallengeApp.Countries" Version="1.0.0" Condition="'$(UseLocalModules)' != 'true'" />
    <ProjectReference Include="../Countries/Countries.csproj" Condition="'$(UseLocalModules)' == 'true'" />
    <ProjectReference Include="../../challenge-app-core/src/Core/Core.csproj" Condition="'$(UseLocalModules)' == 'true' And Exists('../../challenge-app-core/src/Core/Core.csproj')" />
    <ProjectReference Include="../../challenge-app-design-system/DesignSystem/DesignSystem.csproj" Condition="'$(UseLocalModules)' == 'true'" />
  </ItemGroup>
</Project>
